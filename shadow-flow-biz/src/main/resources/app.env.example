@echo off
REM ============================================================
REM  app.env — 应用密钥（**属于部署机器，不随 jar 发布**，v1.7.3 起）
REM
REM  【放在哪】服务器部署目录，与 shadow-flow-biz.jar 同级：
REM      /home/stock-backtesting/app.env        （chmod 600，属主 root）
REM  本地开发另存一份在项目根的 ./app.env（或 src/main/resources/app.env 当兜底）。
REM  app.env 已列入 .gitignore，永远不会被提交；本模板只留占位符。
REM
REM  【为什么不打进 jar】v1.6.4~v1.7.2 是打进 jar 的，结果「谁打包谁决定凭据」：
REM    GitHub Actions 用仓库 Secret 打一份、本地用本机文件打一份，两边互相覆盖，
REM    线上凭据会随发布方式漂移（2026-10-20 GitHub 三方登录莫名变回未开通就是这么来的）。
REM    现在 pom 里 exclude 了 app.env，包里不再有它。
REM
REM  这一份装的是「密钥 / 凭据」，与 server.env（运行参数）严格分工：
REM    app.env     数据库口令、超管初始口令、行情服务令牌、钉钉机器人、GitHub OAuth —— 不入库
REM    server.env  部署目录 / JDK / JVM / 启动参数 —— 入库并会上传服务器
REM
REM  【读取方】两层，值同源：
REM    1) sh/remote.sh 启动前逐行 export 成进程环境变量（服务器发布走这条）；
REM    2) ShadowFlowApplication.main() 最先调 AppEnv.load()：先找外部文件
REM       （-Dapp.env.file → $APP_ENV_FILE → 当前目录 ./app.env），
REM       再拿 classpath 兜底。
REM    最终 application.yml 里的 ${DB_PASSWORD} 这类占位符自然解析到真实值。
REM
REM  【优先级】-D 系统属性 > 环境变量 > 外部 app.env > classpath
REM    高优先级已有同名键时，低优先级不覆盖（-D / --xxx 命令行参数依旧能压制这里）。
REM
REM  格式沿用 set "K=V"（裸 K=V 也认）；REM / # 开头与空行是注释。
REM  值仍是「在此填写…」占位文字的行视为未填写，启动时跳过、按未配置处理。
REM
REM  ⚠️ 值里的 & " 等字符整体在双引号内，无需转义；不要给值加首尾空格。
REM ============================================================

REM ---------- 数据库口令（spring.datasource.password）----------
REM 仅数据库模式（shadowflow.db.enabled=true）连 MySQL 时用；无数据库模式下不参与连接。
REM 未设置时为空串，数据库模式会连接失败，这是有意的——口令不该有明文兜底。
set "DB_PASSWORD=在此填写数据库口令"

REM ---------- 超管初始口令（app.admin.password / ADMIN_PASSWORD）----------
REM 只在「admin 账号还不存在」时用于初始化，之后一律以页面改过的为准
REM （否则每次重启都会把密码打回初始值）。新装环境必须设置，否则超管无法登录。
set "ADMIN_PASSWORD=在此填写超管初始口令"

REM ---------- 行情数据服务令牌（shadowflow.api.token / SHADOWFLOW_API_TOKEN）----------
REM 数据更新的核心凭据。v1.5.9 起优先读超管在「系统配置 → 第三方对接」页维护的配置行；
REM 这里只作出厂兜底，配置行没填时用它。
set "SHADOWFLOW_API_TOKEN=在此填写行情数据服务令牌"

REM ---------- 系统通知机器人 Webhook（watch.dingtalk.webhook / DINGTALK_WEBHOOK）----------
REM 含 access_token 的整体 URL，平台消息（发布通知 / 注册通知 / 用户反馈）与盯盘默认群都走它。
REM 同样优先读「系统配置 → 第三方对接」页的配置行，这里只作出厂兜底。
set "DINGTALK_WEBHOOK=在此填写钉钉机器人 Webhook（https://oapi.dingtalk.com/robot/send?access_token=...）"

REM ---------- GitHub 三方登录（app.auth.github.*）----------
REM 在 GitHub → Settings → Developer settings → OAuth Apps 新建一个 App 拿到这两个值。
REM Authorization callback URL 填：http(s)://<本站域名>/api/auth/github/callback
REM 两项都填写后 GitHub 登录自动开通（前端登录弹窗出现 GitHub 按钮）；
REM 任一为空 = 未开通，不影响邮箱密码登录。
set "GITHUB_CLIENT_ID=在此填写 GitHub OAuth App 的 Client ID"
set "GITHUB_CLIENT_SECRET=在此填写 GitHub OAuth App 的 Client Secret"

REM ---------- 邮箱验证码发信账号（app.mail.*）----------
REM 只有注册要向用户邮箱发一次性验证码（登录只要邮箱 + 密码，不需要验证码）。
REM 这里填的是「发信账号」：QQ 邮箱要填 SMTP 授权码（设置 → 账户 → 开启 SMTP 服务后生成），
REM 不是邮箱登录密码。两项任一为空 = 邮件服务未开通：注册会明确报「邮件服务未配置」，
REM 登录与 GitHub 三方登录不受影响。
set "MAIL_USERNAME=在此填写发信邮箱（如 xxx@qq.com）"
set "MAIL_PASSWORD=在此填写该邮箱的 SMTP 授权码"
