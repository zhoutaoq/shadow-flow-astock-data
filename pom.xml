<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         影流数据 Shadow Flow Data —— 聚合工程
         两个模块：
           shadow-flow-notify  通用通知能力 SDK（通道 SPI + 目标解析 SPI + 开关/时段/限流策略，
                               不含任何业务语义，可单独给别的项目用）
           shadow-flow-biz     Web 服务（Spring Boot 应用），依赖 notify
         只在这里收口版本与编译参数，模块各自的依赖写在各模块 pom 里。
         ============================================================ -->
    <groupId>io.github.zhoutaoq</groupId>
    <artifactId>shadow-flow-parent</artifactId>
    <version>1.7.3</version>
    <packaging>pom</packaging>
    <name>shadow-flow</name>
    <description>影流数据 · Shadow Flow Data（聚合工程）</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.6</version>
        <relativePath/>
    </parent>

    <modules>
        <module>shadow-flow-notify</module>
        <module>shadow-flow-biz</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 页脚要展示「发布时间」：这里固定成 UTC 的 ISO-8601（尾部 Z），
             VersionController 收到后转北京时间。不写死格式的话 Maven 各版本默认值不一致，
             Instant.parse 可能解析失败，页脚就只能显示原始串甚至空。 -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    </properties>
</project>
