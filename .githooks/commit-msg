#!/usr/bin/env sh
# =============================================================================
# commit-msg — 保证每条提交都注明模型名（见 AGENTS.md 第 1 节）
#
# 启用（仓库根目录执行一次）：
#     git config core.hooksPath .githooks
#     git config ai.model dsv4.1flash
#
# 行为：消息里已有 "Model: xxx" 行则原样放行；没有则自动补一行。
#       取值顺序 AI_MODEL 环境变量 -> git config ai.model -> unknown。
#       只补齐、不拦截（不返回非 0），不影响任何正常提交。
# =============================================================================
set -u

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# 空消息（如 --allow-empty-message）交给 git 自己判，这里不插手
grep -qv '^[[:space:]]*\(#.*\)\?$' "$msg_file" 2>/dev/null || exit 0

# git 自己生成的提交：Merge / Revert / fixup! / squash! / amend 的 tmp 消息
subject=$(grep -v '^[[:space:]]*#' "$msg_file" | grep -v '^[[:space:]]*$' | head -n 1)
case "$subject" in
    Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

# 已有 Model: 行（大小写不敏感，允许 Model-2: 并存）
if grep -qiE '^Model[[:space:]-]*[0-9]*:[[:space:]]*[^[:space:]]' "$msg_file"; then
    exit 0
fi

model="${AI_MODEL:-}"
if [ -z "$model" ]; then
    model=$(git config --get ai.model 2>/dev/null || true)
fi
model=$(printf '%s' "$model" | tr -d '[:space:]')
if [ -z "$model" ]; then
    model="unknown"
    echo "[commit-msg] 未配置模型名，已补 Model: unknown；建议执行 git config ai.model <你的模型名>" >&2
fi

# 补在消息末尾。git 在钩子之后才会清理 '#' 注释行，因此追加在末尾不会被误删。
printf '\nModel: %s\n' "$model" >> "$msg_file"
echo "[commit-msg] 已注明 Model: $model" >&2
exit 0
