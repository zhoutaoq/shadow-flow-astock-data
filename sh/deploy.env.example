@echo off
REM ============================================================
REM  deploy.env.example — 服务器连接信息模板
REM
REM  【首次使用】把本文件复制成同目录下的 deploy.env，填入真实值：
REM      copy deploy.env.example deploy.env
REM  deploy.env 已列入 .gitignore，永远不会被提交；本模板只留占位符。
REM
REM  ⚠️ 本文件含口令，属于密钥文件：不要改成别的名字绕过 .gitignore，
REM     也不要贴到聊天/文档/截图里。
REM ============================================================

REM 登录目标，格式 用户@服务器IP
set "SSH=root@0.0.0.0"

REM 登录口令
set "PWD=在此填写服务器口令"

REM 服务器主机指纹（SHA256）。取法：本机在该目录执行
REM     plink.exe -batch -pw <口令> root@<IP> "echo x"
REM 报错信息里会打印：
REM     The server's ssh-ed25519 key fingerprint is:
REM       ssh-ed25519 255 SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REM 把 SHA256: 连同后面 43 位一起原样粘过来（共 50 字符，含 "SHA256:" 7 位）。
REM 少一个字符会让 pscp 报 "not a valid format for a manual host key specification"。
set "HOSTKEY=SHA256:在此粘贴43位base64指纹"
