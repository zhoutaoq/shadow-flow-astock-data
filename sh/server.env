@echo off
REM ============================================================
REM  server.env — 服务器运行参数（不含任何密钥，可入版本库）
REM
REM  读取方：
REM    本机  sh\deploy.bat  ：直接 call 本文件，取 REMOTE_DIR / JAR_NAME
REM    远端  sh/remote.sh   ：按行解析本文件，取 JAVA / OPTS / ARGS / LOG
REM          （deploy.bat 每次发布都会把本文件上传到 REMOTE_DIR）
REM
REM  格式固定为 cmd 的 set "K=V"：.bat 能直接 call，bash 按行解析也认得。
REM  ⚠️ 连接信息（IP / 账号 / 口令 / 主机指纹）不在这里，在 deploy.env（不入库）。
REM ============================================================

REM 远端部署目录：jar、日志、remote.sh、本文件都放这里
set "REMOTE_DIR=/home/stock-backtesting"

REM jar 基名：正式 jar = <JAR_NAME>.jar；上传时先落成 <JAR_NAME>.jar.new，探活成功才改名
REM v1.6.0 起 jar 名由 stock-kline-data-crawler 改为 shadow-flow-biz（多模块拆分的业务模块名）。
REM ⚠️ 换名后远端残留的老包不会被 swap_jar 的清理规则扫到，首次发布要手工删一次旧包。
set "JAR_NAME=shadow-flow-biz"

REM 远端 JDK（服务器上的绝对路径）
set "JAVA=/usr/bin/java"

REM JVM 参数
set "OPTS=-Xms256m -Xmx768m -XX:+UseG1GC"

REM 应用启动参数 —— 每次发布都读这里，改参数不用动任何脚本。
REM   --server.port=8080                       对外端口（remote.sh 的探活也从这里取端口）
REM   --shadowflow.notify.enabled=true          通知总开关（v1.6.0 由 --watch.dingtalk.enabled 改名而来）。
REM                                             yml 里默认 false，不显式打开则线上一条通知都发不出去
REM                                             （盯盘告警 / 关键时点快报 / 启动通知 / 注册通知 / 用户反馈全哑）。
REM                                             老参数已失效，带着它启动只会在日志里得到一条 WARN。
REM   --watch.startup-notify.enabled=true       发「【生产发布】盯盘系统 <版本> 已启动」
set "ARGS=--server.port=8080 --shadowflow.notify.enabled=true --watch.startup-notify.enabled=true"

REM 日志文件名（相对 REMOTE_DIR）
set "LOG=app.log"
