# 本机运行期盯盘配置：含钉钉 webhook 与个人盯盘名单，不入库
/watch-config.json

# v1.3 数据文件根目录：运行期生成，不入库
data/

# 发布配置：含服务器地址与口令，不入库
stock-kline-deploy-config.yaml

# 发布脚本目录 sh/：脚本与服务器运行参数入库（deploy.bat / remote.sh / server.env /
# deploy.env.example / 使用说明.md），只排除下面两类别的东西 ——
#   ① 连接凭据：服务器 IP / 账号 / 口令 / 主机指纹，单独放 deploy.env（由 deploy.env.example 复制而来）
#   ② 第三方二进制：PuTTY 的 plink.exe / pscp.exe，按需自行下载，不塞进仓库
# 应用密钥 app.env（数据库口令 / 超管初始口令 / 行情令牌 / 钉钉机器人）自 v1.6.4 起
# 放 shadow-flow-biz/src/main/resources 下、随包走（AppEnv 从 classpath 装载），
# 真实值同样不入库；模板 app.env.example 入库。
sh/deploy.env
sh/plink.exe
sh/pscp.exe
shadow-flow-biz/src/main/resources/app.env
# 本地开发用的密钥文件（放在项目根，AppEnv 从工作目录读）：含数据库口令/超管口令/发信授权码，绝不入库
/app.env

# 构建产物 / 日志
target/
*.log
*.jar.new

docs
